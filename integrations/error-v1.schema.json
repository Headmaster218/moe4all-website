{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoE4All error/1 decoded payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at_utc", "engine_version", "failure_kind", "description", "error", "logs", "privacy"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
    "created_at_utc": { "type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$" },
    "engine_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "engine_commit": { "type": ["string", "null"] },
    "failure_kind": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
    "engine": { "type": ["object", "null"] },
    "hardware": { "type": ["object", "null"] },
    "model": { "type": ["object", "null"] },
    "launch": { "type": ["object", "null"] },
    "error": {
      "type": "object", "required": ["message", "chain"],
      "properties": { "message": { "type": "string" }, "chain": { "type": "array", "items": { "type": "string" } } }
    },
    "logs": {
      "type": "object", "required": ["startup", "tail", "speed_statistics_included"],
      "properties": {
        "startup": { "type": "array", "maxItems": 220, "items": { "type": "string" } },
        "tail": { "type": "array", "maxItems": 12, "items": { "type": "string" } },
        "dropped_events": { "type": "integer", "minimum": 0 },
        "speed_statistics_included": { "const": false }
      }
    },
    "privacy": {
      "type": "object", "required": ["prompt_or_response_included", "local_paths_redacted", "api_keys_included"],
      "properties": { "prompt_or_response_included": { "const": false }, "local_paths_redacted": { "const": true }, "api_keys_included": { "const": false } }
    }
  }
}
